theme = Ayu
background = #000000
font-family = BerkeleyMono Nerd Font Ligatures
font-feature = +calt,+ss02,+ss06,+ss07,+ss08
font-size = 14
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
unfocused-split-opacity = 0.5
macos-titlebar-style = hidden

keybind = ctrl+shift+tab=goto_split:previous
keybind = ctrl+tab=goto_split:next
keybind = ctrl+shift+r=text:\x1b[82;6u

# Route primary layout shortcuts into the active Herdr client (prefix = Ctrl-B).
keybind = super+digit_1=text:\x02\x31
keybind = super+1=text:\x02\x31
keybind = super+digit_2=text:\x02\x32
keybind = super+2=text:\x02\x32
keybind = super+digit_3=text:\x02\x33
keybind = super+3=text:\x02\x33
keybind = super+digit_4=text:\x02\x34
keybind = super+4=text:\x02\x34
keybind = super+digit_5=text:\x02\x35
keybind = super+5=text:\x02\x35
keybind = super+digit_6=text:\x02\x36
keybind = super+6=text:\x02\x36
keybind = super+digit_7=text:\x02\x37
keybind = super+7=text:\x02\x37
keybind = super+digit_8=text:\x02\x38
keybind = super+8=text:\x02\x38
keybind = super+digit_9=text:\x02\x39
keybind = super+9=text:\x02\x39
keybind = super+t=text:\x02c
keybind = super+d=text:\x02v
keybind = super+shift+d=text:\x02-
keybind = super+shift+[=text:\x02p
keybind = super+shift+]=text:\x02n
keybind = super+[=text:\x02\x1b[Z
keybind = super+]=text:\x02\t
keybind = super+n=text:\x02N
keybind = super+w=text:\x02x
keybind = super+shift+w=text:\x02D
keybind = super+shift+enter=text:\x02z
