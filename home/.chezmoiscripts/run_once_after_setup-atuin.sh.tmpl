#!/bin/sh
set -eu
atuin=/opt/homebrew/bin/atuin
"$atuin" status >/dev/null 2>&1 && exit 0
printf 'Unlock 1Password so op can read the Atuin item, then press Enter. ' >/dev/tty
read -r _ </dev/tty
op read "op://Private/Atuin/password" |
    ATUIN_ENCRYPTION_KEY="$(op read "op://Private/Atuin/key")" \
        "$atuin" login -u "$(op read "op://Private/Atuin/username")" -p -
"$atuin" sync
