{{- $roles := dig "machines" .host "roles" (list) . -}}
{{- if has "web-dev" $roles -}}
#!/bin/sh
set -eu
vp=$HOME/.local/share/vite-plus/bin/vp
[ -x "$vp" ] || curl -fsSL https://vite.plus | VP_NODE_MANAGER=yes VP_PM_MANAGER=yes bash
{{- if has "web-hosting" $roles }}
for package in cf netlify-cli wrangler; do
    "$vp" list -g 2>/dev/null | grep -q "^$package@" || "$vp" install -g "$package"
done
{{- end }}
{{ end -}}
