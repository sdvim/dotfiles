Host{{ range $name, $_ := .machines }} {{ $name }}{{ end }}
    HostName %h.{{ .tailnet }}
    StrictHostKeyChecking accept-new
    ControlMaster auto
    ControlPath ~/.ssh/control-%C
    ControlPersist 10m
{{- range $name, $machine := .machines }}{{ with dig "user" "" $machine }}

Host {{ $name }}
    User {{ . }}
{{- end }}{{ end }}
{{- if eq .chezmoi.os "darwin" }}

Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}
