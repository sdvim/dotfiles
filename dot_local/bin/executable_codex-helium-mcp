#!/bin/sh
set -eu
. "$HOME/.config/frontend-tools/env.sh"
helium='/Applications/Helium.app/Contents/MacOS/Helium'
[ -x "$helium" ] || { echo 'frontend tools: install helium-browser with Homebrew' >&2; exit 1; }
server=$("$FRONTEND_MISE" which chrome-devtools-mcp --tool npm:chrome-devtools-mcp@1.9.0)
artifacts="${XDG_CACHE_HOME:-$HOME/.cache}/frontend-verification"
umask 077
mkdir -p "$artifacts"
export CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS=1
exec "$server" --executablePath "$helium" --isolated --no-usage-statistics --no-performance-crux --workspace "$artifacts" "$@"
