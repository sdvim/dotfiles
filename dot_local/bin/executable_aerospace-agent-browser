#!/bin/sh
set -eu
PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
export PATH
window=${AEROSPACE_WINDOW_ID:-}
[ -n "$window" ] || exit 0
pid=$(aerospace list-windows --all --format '%{window-id} %{app-pid}' |
  awk -v window="$window" '$1 == window { print $2; exit }')
[ -n "$pid" ] || exit 0
command=$(ps -p "$pid" -o command=) || exit 0
# Match browser-control transports used by Playwright and Chrome DevTools.
case " $command " in
  *' --remote-debugging-pipe '*|*' --remote-debugging-port=0 '*)
    aerospace move-node-to-workspace --window-id "$window" 5 ;;
esac
